# ============================================================================
# Plantilla de variables del FrontEnd
#
#   cp .env.example .env
#
# Vite solo expone al navegador las variables con prefijo VITE_.
# TODO lo que se ponga aquí acaba en el bundle: nunca secretos de servidor.
# ============================================================================

# URL base del BackEnd. Sustituye a las 14 apariciones de
# "http://localhost:8081" que estaban escritas a mano en los componentes.
VITE_API_URL=http://localhost:8081

# Clave de Google Maps. Restríngela por dominio en la consola de Google:
# al ir en el bundle, es visible para cualquiera que abra la aplicación.
VITE_GOOGLE_MAPS_API_KEY=tu-clave-de-google-maps

# Client ID de Google OAuth (público por diseño).
VITE_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# Client ID de GitHub OAuth (público por diseño).
VITE_GITHUB_CLIENT_ID=tu-client-id

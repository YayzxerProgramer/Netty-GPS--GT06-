# ============================================================================
# Plantilla de variables del Servidor-TCP
#
#   cp .env.example .env
# ============================================================================

# Puerto TCP donde escuchan los dispositivos GT06.
GPS_TCP_PUERTO=9000

# Puerto HTTP de este módulo (no es el de los GPS).
SERVER_PORT=8080

# URL del backend al que se reenvían las posiciones.
BACKEND_BASE_URL=http://localhost:8081

# Clave compartida con el BackEnd. DEBE coincidir exactamente con
# GPS_INGESTA_API_KEY de BackEnd/.env, o el backend rechazará las posiciones
# con 401 y se perderán todas las tramas.
GPS_INGESTA_API_KEY=la-misma-que-en-BackEnd/.env

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot 3.4.3, la misma versión que el BackEnd.

        Antes este módulo usaba 4.0.2 y el BackEnd 3.4.3: dos majors distintos
        en el mismo repositorio, en módulos que se hablan por HTTP. Eso implica
        versiones incompatibles de Spring Framework, Jackson, Netty y Tomcat
        entre los dos lados, y hace que lo que funciona en uno no sirva de
        referencia para el otro.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.3</version>
        <relativePath/>
    </parent>

    <groupId>com.servidortpc</groupId>
    <artifactId>servidor-tcp</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>RompGPS Servidor TCP</name>
    <description>Receptor TCP del protocolo GT06 para dispositivos GPS</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            spring-boot-starter-web incluye a spring-boot-starter, así que ya no
            se declaran los dos. Tampoco spring-boot-starter-webmvc, que es el
            nombre que tiene este mismo starter en Boot 4: el pom anterior
            declaraba ambos, duplicando la dependencia.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            Solo lo que hace falta para un servidor TCP.
            netty-all arrastraba todos los transportes y códecs (HTTP/2, QUIC,
            DNS, SMTP...) cuando este módulo únicamente necesita el transporte
            NIO, el handler de inactividad y el códec base.
        -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-handler</artifactId>
        </dependency>

        <!-- Carga el archivo .env en desarrollo local. -->
        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>spring-dotenv</artifactId>
            <version>4.0.0</version>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>

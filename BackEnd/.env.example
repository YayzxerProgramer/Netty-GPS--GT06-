# ============================================================================
# Plantilla de variables del BackEnd
#
#   cp .env.example .env
#
# Después rellena los valores. El archivo .env está en .gitignore y NUNCA debe
# commitearse. spring-dotenv lo carga automáticamente al arrancar.
#
# Si falta cualquiera de las variables sin valor por defecto, la aplicación NO
# arranca. Es intencionado: es preferible no arrancar a arrancar sin seguridad.
# ============================================================================

# ---------- Servidor ----------
SERVER_PORT=8081

# ---------- PostgreSQL ----------
# El puerto es 5435 y no 5432 porque en Windows el servicio nativo de Postgres
# ocupa el 5432 y tiene prioridad sobre el proxy de Docker.
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=rompgps_users
POSTGRES_USER=rompgps
POSTGRES_PASSWORD=cambia-esto

# ---------- MongoDB ----------
MONGODB_URI=mongodb://rompgps:cambia-esto@localhost:27017/Romp_Gps?authSource=admin

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=cambia-esto

# ---------- JWT ----------
# Mínimo 32 bytes. Generar con:  openssl rand -base64 48
# Cambiarlo invalida todas las sesiones activas.
JWT_SECRET=genera-uno-nuevo-con-openssl-rand-base64-48
JWT_EXPIRACION=900000
JWT_REFRESCO_EXPIRACION=604800000

# ---------- OAuth2 ----------
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GITHUB_CLIENT_ID=tu-client-id
# ROTAR: el anterior estuvo publicado en el repositorio.
GITHUB_CLIENT_SECRET=tu-client-secret

# ---------- CORS ----------
CORS_ORIGENES=http://localhost:5173

# ---------- Ingesta GPS ----------
# Clave compartida con el Servidor-TCP: el mismo valor debe ir en
# Servidor-TCP/servidor-tpc/.env  ->  GPS_INGESTA_API_KEY
# Generar con:  openssl rand -hex 32
GPS_INGESTA_API_KEY=genera-una-con-openssl-rand-hex-32

# ---------- Límite de intentos de login ----------
RATE_LIMIT_INTENTOS=5
RATE_LIMIT_VENTANA=300
RATE_LIMIT_BLOQUEO=900

# ---------- Administrador inicial ----------
# Solo actúa si no existe ningún ADMIN en la base de datos.
ADMIN_USUARIO=admin
ADMIN_CONTRASENA=cambia-esto-minimo-8-caracteres
ADMIN_CORREO=admin@rompgps.local

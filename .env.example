# ============================================================================
# Plantilla de variables para docker compose
#
#   cp .env.example .env
#
# docker compose lee el archivo .env de esta carpeta automáticamente.
# Las contraseñas deben coincidir con las de BackEnd/.env.
# ============================================================================

# ---------- PostgreSQL ----------
POSTGRES_DB=rompgps_users
POSTGRES_USER=rompgps
POSTGRES_PASSWORD=cambia-esto

# ---------- MongoDB ----------
MONGO_INITDB_ROOT_USERNAME=rompgps
MONGO_INITDB_ROOT_PASSWORD=cambia-esto

# ---------- Redis ----------
REDIS_PASSWORD=cambia-esto
